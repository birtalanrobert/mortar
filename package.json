{
  "name": "mortar",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build && node scripts/sync-entries.mjs",
    "clean": "pnpm -r --filter './packages/**' run clean",
    "typecheck": "pnpm run build && pnpm -r --filter './packages/**' run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "test:integration": "vitest run --config vitest.integration.mts",
    "new:migration": "node scripts/new-migration.mjs",
    "new:package": "node scripts/new-package.mjs",
    "publish:local": "pnpm build && node scripts/publish-local.mjs",
    "registry:up": "docker compose -f ../docker-compose.yml up -d --wait"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8",
    "@nestjs/common": "^11.2.2",
    "@nestjs/core": "^11.2.2",
    "@nestjs/typeorm": "^11.0.3",
    "typeorm": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pino": "^10.3.1",
    "pg": "^8.13.1",
    "bullmq": "^6.2.1",
    "ioredis": "^5.4.1"
  }
}
