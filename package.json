{
  "name": "mortar",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build && node scripts/sync-entries.mjs",
    "clean": "pnpm -r --filter './packages/**' run clean",
    "typecheck": "pnpm run build && pnpm -r --filter './packages/**' run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "test:integration": "vitest run --config vitest.integration.mts",
    "new:migration": "node scripts/new-migration.mjs",
    "new:package": "node scripts/new-package.mjs",
    "check:publishable": "node scripts/check-publishable.mjs",
    "release:check": "pnpm build && pnpm check:publishable && pnpm check:readmes && pnpm test && node scripts/publish-npm.mjs --dry-run",
    "release": "pnpm build && pnpm check:publishable && node scripts/publish-npm.mjs",
    "version:set": "node scripts/version.mjs",
    "version:bump": "node scripts/version.mjs",
    "check:readmes": "node scripts/check-readmes.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@eslint/js": "^9.17.0",
    "@nestjs/common": "^11.2.2",
    "@nestjs/core": "^11.2.2",
    "@nestjs/testing": "^11.2.3",
    "@nestjs/typeorm": "^11.0.3",
    "@swc/core": "^1.16.1",
    "@types/node": "^22.10.5",
    "bullmq": "^6.2.1",
    "eslint": "^9.17.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.8"
  },
  "license": "AGPL-3.0-only"
}
