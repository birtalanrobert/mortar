# Auth for the local registry.
#
# Verdaccio permits anonymous publish for @birtalanrobert/* (see
# ../.registry/conf/config.yaml), but the npm client refuses to attempt a
# publish without *some* token, so this supplies one. It authorises nothing:
# the registry is bound to localhost and holds only what is already on disk.
//localhost:3052/:_authToken=local-development-only

# The clean-tree requirement is enforced by scripts/publish-npm.mjs, which
# names the offending files. Leaving pnpm's own check on would give two
# definitions of "clean" and forward an unknown --git-checks flag to npm.
git-checks=false
