{
  "name": "@mortar/database",
  "version": "0.1.0",
  "description": "TypeORM DataSource, transactional context and migration conventions",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@mortar/context": "workspace:*",
    "@mortar/config": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "typeorm": "^0.3.0 || ^1.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/typeorm": {
      "optional": true
    }
  }
}
