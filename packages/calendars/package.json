{
  "name": "@birtalanrobert/calendars",
  "version": "1.0.0",
  "description": "Two-way calendar sync: our appointments pushed out, their busy time pulled in",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "nestjs",
    "google",
    "microsoft",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./google": {
      "types": "./dist/providers/google.d.ts",
      "default": "./dist/providers/google.js"
    },
    "./microsoft": {
      "types": "./dist/providers/microsoft.d.ts",
      "default": "./dist/providers/microsoft.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@birtalanrobert/database": "workspace:^",
    "@birtalanrobert/http": "workspace:^",
    "@birtalanrobert/observability": "workspace:^",
    "@birtalanrobert/tenancy": "workspace:^",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "googleapis": "^178.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "typeorm": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birtalanrobert/mortar.git",
    "directory": "packages/calendars"
  },
  "author": "Robert Birtalan"
}
