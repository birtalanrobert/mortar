{
  "name": "@birtalanrobert/messaging",
  "version": "1.0.1",
  "description": "SMS segment counting, quiet hours, pumping detection and a message credit ledger",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "nestjs",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "dependencies": {
    "@birtalanrobert/database": "workspace:^",
    "@birtalanrobert/tenancy": "workspace:^"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "typeorm": "^1.0.0"
  }
}
