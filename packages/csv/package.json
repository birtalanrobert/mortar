{
  "name": "@birtalanrobert/csv",
  "version": "1.1.1",
  "description": "Reading and writing the tabular files a spreadsheet actually produces",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birtalanrobert/mortar.git",
    "directory": "packages/csv"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "default": "./dist/xlsx.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "fflate": "^0.8.3"
  }
}
