{
  "name": "@mortar/redis",
  "version": "0.1.0",
  "description": "Redis connections, locks, caching and rate limiting",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "type": "commonjs",
  "dependencies": {
    "@mortar/config": "workspace:*",
    "@mortar/context": "workspace:*",
    "@mortar/observability": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
