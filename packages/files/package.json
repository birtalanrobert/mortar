{
  "name": "@birtalanrobert/files",
  "version": "1.0.0",
  "description": "Pre-signed uploads, per-tenant key scoping, virus scanning and retention",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "nestjs",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@birtalanrobert/context": "workspace:^",
    "@birtalanrobert/database": "workspace:^",
    "@birtalanrobert/http": "workspace:^",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "typeorm": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "mortar": {
    "entries": [
      "nestjs"
    ]
  }
}
