{
  "name": "@birtalanrobert/files",
  "version": "1.5.0",
  "description": "Pre-signed uploads, per-tenant key scoping, the image pipeline, virus scanning and retention",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birtalanrobert/mortar.git",
    "directory": "packages/files"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "default": "./dist/images/index.js"
    },
    "./print": {
      "types": "./dist/print/index.d.ts",
      "default": "./dist/print/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "nestjs",
    "images",
    "print",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@birtalanrobert/context": "workspace:^",
    "@birtalanrobert/database": "workspace:^",
    "@birtalanrobert/http": "workspace:^",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "sharp": "^0.35.4",
    "typeorm": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "mortar": {
    "entries": [
      "nestjs",
      "images",
      "print"
    ]
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@types/qrcode": "^1.5.5",
    "jsqr": "^1.4.0",
    "sharp": "^0.35.4"
  }
}
